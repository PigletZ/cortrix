  "cards": [
    {
      "dot": "cyan",
      "title": "存储与职责",
      "items": [
        "agent_trace 全局存 catalog.db；interaction_log / sources 位于各 NS 的 memory.db。",
        "全局清理由 ObservabilityModule/CleanupScheduler 执行；InteractionLogSweeper 遍历各 NS。"
      ]
    },
    {
      "dot": "cyan",
      "title": "健康与指标",
      "items": [
        "ready 不是所有 namespace 的实际检索验证。",
        "metrics 独立于 trace/op log；运行日志另由 spdlog 输出。"
      ]
    }
  ]
